# Copy to .env and fill values manually. Never commit .env.
# Local defaults match scripts/embedded-db.mjs. For production, point both at a
# managed PostgreSQL instance and use separate databases for app and tests.
DATABASE_URL="postgresql://postgres:titanapt_local@localhost:55432/titanapt_dev?schema=public"
TEST_DATABASE_URL="postgresql://postgres:titanapt_local@localhost:55432/titanapt_test?schema=public"

NODE_ENV=development
PORT=4000
WEB_ORIGIN="http://localhost:5173"
COOKIE_SECURE=false
TRUST_PROXY=false
AUTO_SEED_ADMIN=true
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="use-a-long-unique-password"
ADMIN_DISPLAY_NAME="TitanApt Admin"

# Recommendation and practice tuning
NO_REPEAT_DAYS=14
WEAK_AREA_MIN_ATTEMPTS=10
WEAK_AREA_THRESHOLD=60

# Optional: point at a production frontend build directory
# WEB_DIST_DIR="apps/web/dist"
